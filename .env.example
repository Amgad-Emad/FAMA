APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Release feature flags (config/features.php). Default ON — the full app.
# For the V1 talent-only, light-only production release, set these to false:
#   FEATURE_BRANDS=false, FEATURE_CONTRACTS=false, FEATURE_MESSAGING=false, FEATURE_DARK_MODE=false
FEATURE_BRANDS=true
FEATURE_CONTRACTS=true
FEATURE_MESSAGING=true
FEATURE_DARK_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail — ZeptoMail SMTP. Switch provider by changing these values only.
# MAIL_SCHEME: leave null for port 587 (Laravel 11+ uses "smtp" and upgrades
# to TLS via STARTTLS automatically); use "smtps" only with port 465.
# There is no MAIL_ENCRYPTION variable on Laravel 11+.
# smtp = ZeptoMail over SMTP (587). If your host blocks outbound SMTP, use
# MAIL_MAILER=zeptomail — same token (MAIL_PASSWORD), sent over HTTPS (443).
MAIL_MAILER=smtp
#ZEPTOMAIL_TOKEN=
#ZEPTOMAIL_HOST=api.zeptomail.com
MAIL_SCHEME=null
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=587
MAIL_TIMEOUT=15
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=your-zeptomail-send-mail-token
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sender profiles (config/mail.php "senders") — real mailboxes that receive replies.
MAIL_SUPPORT_ADDRESS="support@example.com"
MAIL_SUPPORT_NAME="${APP_NAME} Support"
MAIL_INFO_ADDRESS="info@example.com"
MAIL_INFO_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS="contact@example.com"
MAIL_CONTACT_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO (ADR-AO). Indexing defaults to ON only when APP_ENV=production; set it explicitly on a
# live site that runs another APP_ENV, and keep it false on staging copies.
SEO_INDEXABLE=
# Fama's own social accounts for the Organization structured data (comma-separated URLs).
SEO_SAME_AS=
